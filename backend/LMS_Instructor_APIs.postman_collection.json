            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"John Doe Updated\",\n  \"bio\": \"Updated bio: Senior web developer with 15+ years of experience\",\n  \"experience_years\": 15\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/instructors/profile/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["instructors", "profile", "{{userId}}"]
            }
