  573  // ---- Quiz Attempts & Results ----
  574: // ---- Quiz Attempts & Results ----
export const quizAttemptApi = {
  async listByQuiz(quizId: string): Promise<QuizAttempt[]> {
    const response = await apiClient.get(
      `/quizzes/attempts/quiz/${quizId}`
    );

    return response.data.data || response.data;
  },

  async listByStudent(studentId: string): Promise<QuizAttempt[]> {
    const response = await apiClient.get(
      `/quizzes/attempts/results/${studentId}`
    );

    return response.data.data || response.data;
  },

  async start(quizId: string, studentId: string): Promise<QuizAttempt> {
    const response = await apiClient.post(
      `/quizzes/attempts/start`,
      {
        quiz_id: quizId,
      }
    );

    return response.data.data || response.data;
  },

  async complete(
    id: string,
    answers: Array<{
      question_id: string;
      selected_option_id?: string;
      answer_text?: string;
    }>
  ): Promise<QuizAttempt> {
    const response = await apiClient.post(
      `/quizzes/attempts/submit`,
      {
        attempt_id: id,
        answers,
      }
    );

    return response.data.data || response.data;
  },
};
